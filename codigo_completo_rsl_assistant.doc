from fastapi import FastAPI, Request, Depends
from fastapi.templating import Jinja2Templates
from fastapi.staticfiles import StaticFiles
from sqlalchemy.orm import Session

from app.database import models
from app.database.database import engine, get_db
from app.routes import projetos, protocolo, artigos, exportacao
from app.services.prisma import calcular_fluxo_prisma
from app.routes import artigos, exportacao, ia, projetos, protocolo

models.Base.metadata.create_all(bind=engine)

app = FastAPI(title="Assistente RSL", version="0.1.0")

templates = Jinja2Templates(directory="app/templates")

app.include_router(projetos.router)
app.include_router(protocolo.router)
app.include_router(artigos.router)
app.include_router(exportacao.router)
app.include_router(ia.router)

@app.get("/dashboard")
def view_dashboard(request: Request, db: Session = Depends(get_db)):
    prisma_data = calcular_fluxo_prisma(db, projeto_id=1)
    return templates.TemplateResponse("dashboard.html", {"request": request, "prisma": prisma_data})

@app.get("/triagem")
def view_triagem(request: Request, db: Session = Depends(get_db)):
    artigo_pendente = db.query(models.Artigo).filter(models.Artigo.status == models.StatusArtigo.IMPORTADO).first()
    return templates.TemplateResponse("triagem.html", {"request": request, "artigo": artigo_pendente})

