ARQUIVO: app/services/deduplicacao.py
======================================================================
import re


def normalizar_texto(texto: str) -> str:
    if not texto:
        return ""
    texto = texto.lower()
    return re.sub(r"[^\w\s]", "", texto).strip()


def encontrar_duplicados(artigos: list) -> list:
    duplicados_ids = []
    vistos_doi = set()
    vistos_titulos = set()

    for artigo in artigos:
        eh_duplicado = False

        if artigo.doi:
            doi_limpo = artigo.doi.strip().lower()
            if doi_limpo in vistos_doi:
                eh_duplicado = True
            else:
                vistos_doi.add(doi_limpo)

        titulo_limpo = normalizar_texto(artigo.titulo)
        if titulo_limpo:
            if titulo_limpo in vistos_titulos:
                eh_duplicado = True
            else:
                vistos_titulos.add(titulo_limpo)

        if eh_duplicado:
            duplicados_ids.append(artigo.id)

    return duplicados_ids

