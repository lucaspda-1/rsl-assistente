{% extends "base.html" %}
{% block title %}Protocolo PICO / PICOC{% endblock %}

{% block content %}
<h2 class="text-2xl font-bold mb-4">Protocolo de Pesquisa (PICO)</h2>
<div class="bg-white p-6 rounded-lg shadow space-y-4">
    <div>
        <label class="font-bold text-gray-700">População / Contexto:</label>
        <p class="text-gray-600">{{ protocolo.populacao or "Não informado" }}</p>
    </div>
    <div>
        <label class="font-bold text-gray-700">Intervenção:</label>
        <p class="text-gray-600">{{ protocolo.intervencao or "Não informado" }}</p>
    </div>
    <div>
        <label class="font-bold text-gray-700">Comparação:</label>
        <p class="text-gray-600">{{ protocolo.comparacao or "Não informado" }}</p>
    </div>
    <div>
        <label class="font-bold text-gray-700">Outcome (Resultados):</label>
        <p class="text-gray-600">{{ protocolo.outcome or "Não informado" }}</p>
    </div>
</div>
{% endblock %}

======================================================================
ARQUIVO: app/templates/triagem.html
======================================================================
{% extends "base.html" %}
{% block title %}Triagem de Artigos{% endblock %}

{% block content %}
<h2 class="text-2xl font-bold mb-4">Painel de Triagem</h2>

{% if artigo %}
<div class="bg-white p-6 rounded-lg shadow space-y-4">
    <h3 class="text-xl font-bold text-gray-800">{{ artigo.titulo }}</h3>
    <p class="text-sm text-gray-500"><strong>Autores:</strong> {{ artigo.autores }} ({{ artigo.ano }})</p>
    <div class="p-4 bg-gray-50 rounded text-gray-700">
        <strong>Resumo:</strong>
        <p class="mt-1 text-sm">{{ artigo.resumo or "Sem resumo disponível." }}</p>
    </div>

    <form action="/artigos/triagem" method="POST" class="flex gap-4 pt-4 border-t">
        <input type="hidden" name="artigo_id" value="{{ artigo.id }}">
        <button type="submit" name="decisao" value="INCLUIR" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-6 rounded">
            Incluir
        </button>
        <button type="submit" name="decisao" value="EXCLUIR" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-6 rounded">
            Excluir
        </button>
    </form>
</div>
{% else %}
<div class="bg-white p-6 rounded-lg shadow text-center text-gray-500">
    Nenhum artigo pendente para triagem no momento!
</div>
{% endif %}
{% endblock %}
