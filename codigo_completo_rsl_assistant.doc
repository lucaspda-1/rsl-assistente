ARQUIVO ATUALIZADO: app/templates/artigos.html
======================================================================
{% if not projeto %}
<div class="bg-white p-6 rounded-lg shadow mb-6">
    <h3>Crie um projeto para começar</h3>
    <p>Os artigos precisam pertencer a um projeto de revisão.</p>
    <form id="form-projeto">
        <input name="nome" required placeholder="Nome do projeto *">
        <textarea name="descricao" placeholder="Descrição do projeto"></textarea>
        <button type="submit">Criar projeto e adicionar artigo</button>
    </form>
</div>
{% else %}
<button id="mostrar-formulario" type="button">+ Adicionar artigo</button>
<div id="painel-artigo" class="hidden">
    <span id="adicionar-artigo"></span>
    <form id="form-artigo">
        <input name="titulo" required placeholder="Título *">
        <input name="autores" placeholder="Autores">
        <input name="ano" type="number" placeholder="Ano">
        <input name="doi" placeholder="DOI">
        <input name="url" type="url" placeholder="URL">
        <input name="fonte" placeholder="Fonte">
        <input name="palavras_chave" placeholder="Palavras-chave">
        <textarea name="resumo" placeholder="Resumo"></textarea>
        <button type="submit">Salvar artigo</button>
    </form>
</div>
{% endif %}

<script>
    const painel = document.getElementById("painel-artigo");
    if (painel) {
        document.getElementById("mostrar-formulario").addEventListener("click", () => painel.classList.toggle("hidden"));
        if (window.location.hash === "#adicionar-artigo") painel.classList.remove("hidden");
        document.getElementById("form-artigo").addEventListener("submit", async (event) => {
            event.preventDefault();
            const dados = Object.fromEntries(new FormData(event.currentTarget).entries());
            dados.projeto_id = {{ projeto.id }};
            dados.ano = dados.ano ? Number(dados.ano) : null;
            const resposta = await fetch("/api/artigos/", {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify(dados)});
            if (resposta.ok) window.location.reload();
        });
    }
    const formProjeto = document.getElementById("form-projeto");
    if (formProjeto) formProjeto.addEventListener("submit", async (event) => {
        event.preventDefault();
        const resposta = await fetch("/projetos/", {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify(Object.fromEntries(new FormData(formProjeto).entries()))});
        if (resposta.ok) window.location.href = `/artigos/${(await resposta.json()).id}#adicionar-artigo`;
    });
</script>

